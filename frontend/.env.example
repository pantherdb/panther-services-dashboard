# Copy to .env.local and fill in. Only VITE_* values reach the app.

# The backend's origin, without /api/v1, when it's on another origin. Empty: the app calls /api/v1
# on its own origin, which the dev server proxies. Read only in src/app/apiBaseUrl.ts.
VITE_API_BASE_URL=

# Dev and preview only: where the relative /api is proxied. Default http://localhost:8020.
API_PROXY_TARGET=

# The path the site is served under, such as /panther-services-dashboard/. Empty: /.
BASE_PATH=
