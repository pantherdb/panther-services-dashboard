# The web image's site: the built UI, and /api/ forwarded to the dashboard's backend. The
# entrypoint writes this to /etc/nginx/conf.d/default.conf, inside nginx's http block, with
# API_UPSTREAM and NGINX_LOCAL_RESOLVERS filled in.

server {
    # IPv4 only, like Docker's default networks. An IPv6 listen stops nginx on a host whose
    # kernel has IPv6 turned off.
    listen 8080;
    server_name _;
    root /srv/site;
    server_tokens off;

    # Uploads are exported logs, several at once: the backend refuses any one file over 200 MB
    # itself, with a message, so this only has to let a whole batch through.
    client_max_body_size 1g;

    # Docker's DNS, from the container's resolv.conf. With the backend's address in a variable,
    # nginx looks its name up again when the answer expires.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        # A variable with no path, so the request's own path goes to the backend unchanged.
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Parsing a large upload, or reading the folder again, can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Vite names each asset by its content, so a new build gets new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Anything that isn't a file is a page of the app: index.html, revalidated on each load so a
    # new build shows at once.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
